rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin status is managed via the /admins collection (Firestore console).
    // To grant admin: create /admins/{uid} with any data.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── field-level validation helpers ───────────────────────────────────────

    // A non-empty string within a max byte length.
    function isValidString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // A 10-digit numeric phone string (Indian format, no country code).
    function isValidPhone(val) {
      return val is string && val.matches('^[6-9][0-9]{9}$');
    }

    // YYYY-MM-DD date string (basic format check).
    function isValidDate(val) {
      return val is string && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // HH:mm time string.
    function isValidTime(val) {
      return val is string && val.matches('^[0-2][0-9]:[0-5][0-9]$');
    }

    // Validate that a user profile write has safe field values.
    function isValidUserProfile() {
      let d = request.resource.data;
      return isValidString(d.displayName, 64)
        && isValidPhone(d.phone)
        && (!('photoURL' in d)    || (d.photoURL is string    && d.photoURL.size() <= 512))
        && (!('email' in d)       || (d.email is string       && d.email.size() <= 254))
        && (!('createdAt' in d)   || (d.createdAt is string))
        && (!('fcmToken' in d)    || (d.fcmToken is string    && d.fcmToken.size() <= 256))
        && (!('fcmTokens' in d)   || (d.fcmTokens is list));
    }

    // Validate that a new booking has required fields with safe values.
    function isValidBooking() {
      let d = request.resource.data;
      return isValidString(d.venueId, 64)
        && isValidString(d.courtId, 64)
        && isValidDate(d.date)
        && isValidTime(d.startTime)
        && isValidTime(d.endTime)
        && d.status == 'confirmed';
    }

    // ── admins ───────────────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── users ────────────────────────────────────────────────────────────────
    // Read by any signed-in user (leaderboard).
    // Writes only to your own profile with validated fields.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && (isAdmin() || request.auth.uid == userId)
        && isValidUserProfile();
      allow delete: if isAdmin();
    }

    // ── venues & courts ──────────────────────────────────────────────────────
    // Publicly readable; admin-managed.
    match /venues/{venueId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courts/{courtId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── bookings ─────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {

      // Signed-in users can read all bookings (slot availability, leaderboard).
      allow read: if isSignedIn();

      // Users can only create bookings for themselves with validated fields.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isValidBooking();

      // Owners can update their own booking (e.g. cancel); they cannot reassign it.
      // Only the status field may change (to 'cancelled').
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'cancelled';

      allow delete: if isAdmin();
    }
  }
}
